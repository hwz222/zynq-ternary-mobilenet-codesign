/include/ "system-conf.dtsi"

/* v1.1: the accelerator belongs to the twn_fuse kernel driver (linux/driver/twn_fuse), which the
 * root file system loads at boot. fuse_0 is the instance name of twn:user:twn_fuse in the block
 * design (vivado/build_bd_fuse.tcl), so the generated node is fuse_0@a0000000; the generator also
 * writes its interrupt (pl_ps_irq0, GIC SPI 89, level high) and its clock.
 *
 * Until v1.0.0 this node said compatible = "generic-uio" and a 256 MB no-map region at
 * 0x6000_0000 was reserved for /dev/mem. The driver allocates its own 8 MB from CMA, so the
 * reservation is gone and those 256 MB are ordinary memory again. */
&fuse_0 {
    compatible = "wjhuang,twn-fuse-1.1";
    status = "okay";
};

/* The AXU2CGB microSD slot has no write-protect switch (microSD cards have none), but the
 * controller's WP input floats and reads as protected, so every write to the FAT boot partition
 * fails. disable-wp tells sdhci to ignore the pin. */
&sdhci1 {
    disable-wp;
};
&sdhci0 {
    disable-wp;
};
